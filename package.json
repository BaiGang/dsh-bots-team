{
  "name": "dsh-bots-team",
  "version": "1.2.0",
  "type": "module",
  "description": "A team of AI bots in the DeepSeek Harness left sidebar: every bot is a DSH Session with its own folder and persona, led by a chief of staff that hands work out.",
  "license": "MIT",
  "author": "BaiGang",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-agents",
    "chat"
  ],
  "homepage": "https://github.com/BaiGang/dsh-bots-team#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaiGang/dsh-bots-team.git"
  },
  "bugs": {
    "url": "https://github.com/BaiGang/dsh-bots-team/issues"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets",
    "docs",
    "test",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
